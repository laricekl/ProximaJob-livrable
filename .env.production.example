APP_NAME=ProximaJob
APP_ENV=production
APP_KEY=base64:REMPLACER_PAR_UNE_CLE_GENEREE
APP_DEBUG=false
APP_URL=https://jobs.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=America/Toronto

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL recommandé. Utiliser DB_URL si l’hébergeur la fournit.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=database.internal
DB_PORT=5432
DB_DATABASE=proximajob
DB_USERNAME=proximajob
DB_PASSWORD=REMPLACER_PAR_UN_SECRET
DB_SSLMODE=require

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REMPLACER
MAIL_PASSWORD=REMPLACER_PAR_UN_SECRET
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
